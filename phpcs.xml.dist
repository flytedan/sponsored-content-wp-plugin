<?xml version="1.0"?>
<ruleset name="Flytedesk Sponsored Content">
	<description>WordPress Coding Standards for the Flytedesk Sponsored Content plugin.</description>

	<file>src</file>
	<file>tests</file>
	<file>sponsored-content-wp-plugin.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<!-- This plugin's minimum supported PHP version, per its "Requires PHP" header. -->
	<config name="testVersion" value="8.1-"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!--
			This plugin uses Composer PSR-4 autoloading (one class per file,
			file named after the class: Converter.php, not
			class-converter.php). WordPress.Files.FileName enforces the
			legacy "class-foo-bar.php" flat-include naming convention, which
			is fundamentally incompatible with PSR-4 - excluding it is the
			documented approach for namespaced, Composer-autoloaded plugins
			rather than an unjustified blanket suppression.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="flytedesk-sponsored-content"/>
			</property>
		</properties>
	</rule>

	<!-- PSR-4 classes are namespaced; WordPress's global-prefix requirement doesn't apply inside src/ or tests/. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>src/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<!-- PHPUnit test methods (testFoo, providerFoo) are camelCase by PHPUnit convention, not WordPress's snake_case. -->
	<rule ref="WordPress.NamingConventions.ValidFunctionName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.NamingConventions.ValidVariableName">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
</ruleset>
