{
    "name": "flytedesk/sponsored-content-wp-plugin",
    "description": "Lets the flytedesk platform push sponsored/native articles to a publisher-owned WordPress site via a REST API, writing correct SEO metadata regardless of which SEO plugin (Yoast, Rank Math, AIOSEO, or none) is active.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "flytedesk",
            "homepage": "https://flytedesk.com"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "squizlabs/php_codesniffer": "^3.9",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Flytedesk\\SponsoredContent\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flytedesk\\SponsoredContent\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "test": [
            "@test:unit",
            "@test:integration"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
